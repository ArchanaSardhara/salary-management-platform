// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  HR_MANAGER
  ADMIN
}

model User {
  id String @id @default(cuid())

  firstName String  @map("first_name")
  lastName  String? @map("last_name")

  email         String  @unique
  passwordHash  String  @map("password_hash")
  emailVerified Boolean @default(false) @map("email_verified")

  role     Role    @default(HR_MANAGER)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @map("updated_at")

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]

  @@map("users")
}

model RefreshToken {
  id        String @id @default(cuid())
  tokenHash String @unique @map("token_hash")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String @id @default(cuid())
  tokenHash String @unique @map("token_hash")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// An employee record. Department and job title are validated against fixed
/// lists in code (src/modules/api/employees/employee.constants.ts). Soft
/// deleted when deletedAt is set; restoring clears it.
model Employee {
  id String @id @default(cuid())

  /// Shown as the employee code, e.g. 42 -> "EMP-000042". Generated by the
  /// database and never changed.
  employeeNumber Int @unique @default(autoincrement()) @map("employee_number")

  firstName   String  @map("first_name")
  /// Optional so single-name (mononymous) employees can be recorded.
  lastName    String? @map("last_name")
  email       String? @unique
  countryCode String  @map("country_code") @db.Char(2)
  department  String
  jobTitle    String  @map("job_title")

  /// Optimistic-concurrency counter: incremented on every write; updates
  /// must send the version they read.
  version Int @default(1)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")

  compensationRecords CompensationRecord[]

  @@index([deletedAt])
  @@index([countryCode])
  @@index([department])
  @@index([jobTitle])
  @@map("employees")
}

enum CompensationType {
  BASE_SALARY
  BONUS
  COMMISSION
  EQUITY_GRANT
  ALLOWANCE
}

enum PayFrequency {
  MONTHLY
  SEMI_MONTHLY
  BI_WEEKLY
  WEEKLY
  ANNUAL
}

/// A single monthly salary record for an employee. Records are append-only;
/// creating a new one does not automatically close the previous one —
/// effectiveTo is user-supplied and can differ from the next record's
/// effectiveFrom (gaps are allowed). effectiveTo IS NULL means the record is
/// currently active.
model CompensationRecord {
  id         String   @id @default(cuid())
  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])

  /// Monthly gross salary amount; stored as an exact decimal, never float.
  amount       Decimal          @db.Decimal(14, 2)
  /// ISO 4217 currency code, validated against the list in
  /// src/common/constants/currency-codes.ts.
  currencyCode String           @map("currency_code") @db.Char(3)
  payFrequency PayFrequency     @default(MONTHLY) @map("pay_frequency")
  type         CompensationType @default(BASE_SALARY)

  changeReason  String?   @map("change_reason")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  /// null means this record is currently active (no end date yet).
  effectiveTo   DateTime? @map("effective_to") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  auditLog AuditLog?

  @@index([employeeId, effectiveFrom])
  @@index([employeeId, effectiveTo])
  @@map("compensation_records")
}

/// One immutable row per CompensationRecord write, capturing who changed
/// compensation and what changed. Written in the same transaction as its
/// CompensationRecord; never updated or deleted.
model AuditLog {
  id                   String             @id @default(cuid())
  compensationRecordId String             @unique @map("compensation_record_id")
  compensationRecord   CompensationRecord @relation(fields: [compensationRecordId], references: [id])

  /// ID of the User who recorded the salary change.
  changedById String?  @map("changed_by_id")
  changedBy   User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedAt   DateTime @default(now()) @map("changed_at")

  /// Snapshot of the employee's previous compensation; null for the first
  /// compensation record.
  beforeValue Json? @map("before_value") @db.JsonB
  /// Snapshot of the newly created compensation record.
  afterValue  Json  @map("after_value") @db.JsonB

  @@index([changedById])
  @@map("audit_logs")
}
