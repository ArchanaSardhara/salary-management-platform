// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  HR_MANAGER
  ADMIN
}

model User {
  id String @id @default(cuid())

  firstName String  @map("first_name")
  lastName  String? @map("last_name")

  email         String  @unique
  passwordHash  String  @map("password_hash")
  emailVerified Boolean @default(false) @map("email_verified")

  role     Role    @default(HR_MANAGER)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model RefreshToken {
  id        String @id @default(cuid())
  tokenHash String @unique @map("token_hash")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String @id @default(cuid())
  tokenHash String @unique @map("token_hash")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// An employee record. Department and job title are validated against fixed
/// lists in code (src/modules/api/employees/employee.constants.ts). Soft
/// deleted when deletedAt is set; restoring clears it.
model Employee {
  id String @id @default(cuid())

  /// Shown as the employee code, e.g. 42 -> "EMP-000042". Generated by the
  /// database and never changed.
  employeeNumber Int @unique @default(autoincrement()) @map("employee_number")

  firstName   String  @map("first_name")
  /// Optional so single-name (mononymous) employees can be recorded.
  lastName    String? @map("last_name")
  email       String? @unique
  countryCode String  @map("country_code") @db.Char(2)
  department  String
  jobTitle    String  @map("job_title")

  /// Optimistic-concurrency counter: incremented on every write; updates
  /// must send the version they read.
  version Int @default(1)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([deletedAt])
  @@index([countryCode])
  @@index([department])
  @@index([jobTitle])
  @@map("employees")
}
