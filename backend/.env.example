# Copy this file to .env and fill in real values for local development.
# All variables here are validated at startup — see src/config/env.schema.ts.
# Note: Prisma's own config (prisma7.config.ts) loads DATABASE_URL itself via
# `dotenv/config`; the app loads it (and every other variable) separately
# through @nestjs/config.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/salary_management
