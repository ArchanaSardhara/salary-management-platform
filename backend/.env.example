# Copy this file to .env and fill in real values for local development.
# All variables here are validated at startup — see src/config/env.schema.ts.
# Note: Prisma's own config (prisma7.config.ts) loads DATABASE_URL itself via
# `dotenv/config`; the app loads it (and every other variable) separately
# through @nestjs/config.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/salary_management

# JWT secrets — must be at least 32 characters each
JWT_ACCESS_SECRET=change-me-access-secret-32-chars-min
JWT_REFRESH_SECRET=change-me-refresh-secret-32-chars-min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL used in password-reset emails and dev redirects
APP_URL=http://localhost:3000

# Resend email (https://resend.com) — optional in development
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=App <no-reply@yourdomain.com>
EMAIL_REPLY_TO=you@yourdomain.com
EMAIL_ACCOUNT=you@yourdomain.com
